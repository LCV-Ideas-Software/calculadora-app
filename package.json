{
  "name": "calculadora-app",
  "version": "4.1.19",
  "description": "Calculadora Financeira — simulador comparativo de câmbio internacional com análise por IA. React 19 + Vite 8 sobre Cloudflare Pages com D1 backing store, integração Gemini para análises contextuais.",
  "license": "AGPL-3.0-or-later",
  "author": "LCV Ideas & Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCV-Ideas-Software/calculadora-app.git"
  },
  "homepage": "https://github.com/LCV-Ideas-Software/calculadora-app#readme",
  "bugs": {
    "url": "https://github.com/LCV-Ideas-Software/calculadora-app/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format --write src",
    "lint": "biome check src",
    "biome": "biome check .",
    "biome:write": "biome check --write .",
    "format:public": "prettier --write \"**/index.html\"",
    "format:public:check": "prettier --check \"**/index.html\""
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "dompurify": "^3.4.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "prettier": "^3.8.4"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "protobufjs": "7.5.8",
    "undici": "6.24.0",
    "vite": "$vite",
    "postcss": "8.5.10"
  }
}
