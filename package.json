{
  "name": "calculadora-app",
  "version": "4.3.5",
  "private": true,
  "description": "Calculadora Financeira — simulador comparativo de câmbio internacional com análise por IA. React 19 + Vite 8 sobre Cloudflare Pages com D1 backing store, integração Gemini para análises contextuais.",
  "license": "AGPL-3.0-or-later",
  "author": "LCV Ideas & Software",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LCV-Ideas-Software/calculadora-app.git"
  },
  "homepage": "https://github.com/LCV-Ideas-Software/calculadora-app#readme",
  "bugs": {
    "url": "https://github.com/LCV-Ideas-Software/calculadora-app/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:d1-contract": "node scripts/verify-d1-contract.mjs",
    "format": "biome format --write src",
    "lint": "biome check src",
    "biome": "biome check .",
    "biome:write": "biome check --write ."
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "0.0.0-insiders.fa81d69",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "0.0.0-insiders.fa81d69",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "vite": "$vite",
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
